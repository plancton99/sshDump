#!/usr/bin/env bash


if command -v pacman
then
	os="sudo pacman -Sy sshpass --noconfirm"
elif command -v apt
then
	os="sudo apt install sshpass"
else
	echo "your os is not supported"
	exit
fi
if ! command -v sshpass
then
	read -p "sshpass is not installed do you want to install it? (y/n) > " option
	if [[ $option == "y" ]]
	then
		eval "$os"
	else
		echo "ok"
		exit 1
	fi
fi
