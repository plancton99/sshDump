read -p "Enter the password: " pass
read -p "Do you want to save to file? (y/n) >  " save
if [[ $save == "y" ]]
then
	shadow=$(sshpass -p $pass ssh $user@$ip "cat /etc/shadow && exit")
	echo "$shadow" >> $ip"-"shadow.txt
	clear
	exit 0
elif [[ $save == "n" ]]
then
